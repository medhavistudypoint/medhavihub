<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medhavi Study Point - Online Test</title>
    <link rel="stylesheet" href="../../global-style.css?v=3.0">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <!-- 🔒 एक्सेस कंट्रोल कोड -->
    <script>
        const userPlan = localStorage.getItem("user_plan");
        if (userPlan !== "FULL" && userPlan !== "GS") {
            alert("इस टेस्ट को देखने के लिए कृपया पहले लॉगिन करें या GS/FULL बैच जॉइन करें!");
            window.location.href = "../../homescience.html"; 
        }
    </script>
</head>
<body>

    <!-- सुरक्षा वॉटरमार्क स्क्रीन -->
    <div class="watermark-overlay">
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
    </div>

    <!-- 1. लॉगिन गेट स्क्रीन -->
    <div id="boxLoginGate" class="login-card">
        <h2>Medhavi Study Point Test Gate</h2>
        <p>कृपया अपना पूरा नाम दर्ज करें और टेस्ट शुरू करें.</p>
        <input type="text" id="txtStudentName" placeholder="अपना नाम यहाँ लिखें..." required>
        <button class="btn-main-action" onclick="validateAndStartQuiz()">परीक्षा शुरू करें 🚀</button>
        <br><br>
        <a href="../../homescience.html" style="color:#64748b; font-weight:600; text-decoration:none;">🔙 विषय चयन पर वापस जाएं</a>
    </div>

    <!-- 2. परीक्षा वर्कस्पेस स्क्रीन -->
    <div id="quizWorkspace" class="hidden">
        <div class="cbt-header" style="background: #0b1e47; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div class="header-left" style="text-align: center; flex: 1; min-width: 220px;">
                <h1 style="color: #facc15; font-size: clamp(18px, 4.8vw, 28px); font-weight: 900; margin: 0; letter-spacing: 0.5px; white-space: nowrap;">MEDHAVI STUDY POINT</h1>
                <p style="color: #ffffff; font-size: clamp(11px, 2.8vw, 14px); margin: 3px 0 0 0; opacity: 0.95; font-weight: 600; white-space: nowrap;">TGT / PGT / NET / DSSSB</p>
            </div>
            <div class="timer-box" id="countdownTimer" style="background: #1e3a8a; border: 2px solid #3b82f6; color: #facc15; padding: 6px 14px; border-radius: 8px; font-size: 18px; font-weight: 800; letter-spacing: 1px; margin: 0 auto;">50:00</div>
        </div>

        <div class="main-container">
            <div class="card-panel">
                <div class="meta-row">
                    <div>
                        <span class="q-badge">प्रश्न: <span id="lblCurrentNum">1</span> / <span id="lblTotalNum">0</span></span>
                        <span class="subject-badge">वस्त्र विज्ञान एवं रेशा परीक्षण</span>
                        <span id="lblQuestionTag" class="tag-badge"></span>
                    </div>
                </div>
                <div id="boxQuestionText" class="question-text">प्रश्न लोड हो रहा है...</div>
                <div id="boxOptionsList"></div>
                <div class="btn-tri-grid">
                    <button class="btn btn-prev" onclick="doNavigatePrev()">◀ पिछला</button>
                    <button class="btn btn-clear" onclick="doClearAnswer()">Clear</button>
                    <button class="btn btn-mark" onclick="doToggleMark()">⭐ Mark</button>
                </div>
                <button id="btnMainNav" class="btn-main-action" onclick="handleMainAction()">अगला ▶</button>
            </div>
            <div class="card-panel">
                <div class="palette-heading">प्रश्न पैलेट ग्रिड</div>
                <div id="boxPaletteGrid" class="grid-matrix"></div>
                <button class="btn-submit-trigger" onclick="triggerTestSubmission()">✔ Submit Test</button>
            </div>
        </div>
    </div>

    <!-- 3. रिपोर्ट डैशबोर्ड स्क्रीन -->
    <div id="boxReportDashboard" class="report-view">
        <div id="captureTarget" style="padding: 25px; background: white; border-radius: 12px;">
            <div class="report-header-title">Medhavi Study Point — Result Dashboard</div>
            <p id="lblReportStudentName" style="font-size: 18px; font-weight: bold; text-align: center; color: #0b1e47; margin-bottom: 20px;"></p>
            <div class="grid-5-columns">
                <div class="metric-card-wrapper"><div class="metric-card m-blue"><div id="valNetScore" class="metric-val">0 / 0</div><div class="metric-title">Score</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-green"><div id="valCorrectCount" class="metric-val">0</div><div class="metric-title">Correct</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-red"><div id="valIncorrectCount" class="metric-val">0</div><div class="metric-title">Incorrect</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-orange"><div id="valSkippedCount" class="metric-val">0</div><div class="metric-title">Skipped</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-purple"><div id="valTimeConsumed" class="metric-val">00:00</div><div class="metric-title">Time</div></div></div>
            </div>
        </div>
        <button class="btn-telegram-share" onclick="captureCardAndOpenGroup()">📸 रिजल्ट इमेज कॉपी करें</button>
        <a href="../../homescience.html" class="btn-dashboard-redirect">🔙 मुख्य डैशबोर्ड पर वापस जाएं</a>
        <div id="boxReviewAnswersList"></div>
    </div>

    <!-- 🎯 टेस्ट डेटासेट और QUIZ_KEY -->
    <script>
        const QUIZ_KEY = "medhavi_textile_testing_fibers_50"; 

        const dataset = [
            { id: 1, tag: "", question: "रेशे को वस्त्र निर्माण के लिए उपयुक्त बनाने में निम्न में से किस गुण-संयोजन का सर्वाधिक महत्त्व है?", options: ["A. पर्याप्त लंबाई, नम्यता, संसक्ति और मजबूती", "B. पर्याप्त चमक, कठोरता, घनत्व और पारदर्शिता", "C. पर्याप्त मोटाई, कठोरता, भार और चिकनापन", "D. पर्याप्त चमक, घनत्व, भंगुरता और पारदर्शिता"], correct: 0, explanation: "किसी पदार्थ का केवल पतला या लंबा होना उसे उपयोगी वस्त्र रेशा नहीं बनाता। उसमें पर्याप्त लंबाई, मजबूती, नम्यता तथा रेशों के आपस में जुड़कर धागा बनाने की क्षमता होनी चाहिए। संसक्ति कम होने पर रेशों को साथ पकड़कर स्थिर धागा बनाना कठिन हो जाता है।" },
            { id: 2, tag: "", question: "वनस्पति रेशों का बीज, तना, पत्ती और फल रेशों में विभाजन मुख्यतः किस आधार पर किया जाता है?", options: ["A. पौधे में रेशा प्राप्त होने के स्थान पर", "B. रेशे में सेल्यूलोज की मात्रा पर", "C. रेशे की परिपक्वता और लंबाई पर", "D. रेशे की मजबूती और महीनता पर"], correct: 0, explanation: "यह वर्गीकरण पौधे के उस भाग पर आधारित है जहाँ से रेशा प्राप्त होता है। उदाहरण के लिए कपास बीज से, लिनन तने से, सिसल पत्ती से और कॉयर फल के आवरण से प्राप्त होता है। अतः एक ही वनस्पति वर्ग के रेशों को उनके प्राप्ति-स्थान के आधार पर आगे बाँटा जा सकता है।" },
            { id: 3, tag: "", question: "कपोक को कपास के साथ एक ही उपवर्ग में रखने का सबसे उपयुक्त कारण क्या है?", options: ["A. दोनों बीज से संबंधित वनस्पति रेशे हैं", "B. दोनों तने से संबंधित वनस्पति रेशे हैं", "C. दोनों पत्ती से संबंधित वनस्पति रेशे हैं", "D. दोनों फल से संबंधित वनस्पति रेशे हैं"], correct: 0, explanation: "कपोक और कपास दोनों बीज से संबंधित रेशों की श्रेणी में आते हैं। यद्यपि उनके भौतिक गुण और वस्त्रीय उपयोग समान नहीं होते, लेकिन वनस्पति भाग के आधार पर वर्गीकरण करने पर दोनों को बीज रेशों में रखा जाता है।" },
            { id: 4, tag: "", question: "रेमी और लिनन को एक ही उपवर्ग में रखने का सर्वाधिक उचित आधार क्या है?", options: ["A. दोनों तने से प्राप्त बास्ट रेशे हैं", "B. दोनों पत्तियों से प्राप्त कठोर रेशे हैं", "C. दोनों बीजों से प्राप्त मुलायम रेशे हैं", "D. दोनों फलों से प्राप्त मोटे रेशे हैं"], correct: 0, explanation: "रेमी और लिनन दोनों तने के बास्ट भाग से प्राप्त किए जाते हैं। बास्ट रेशे तने की बाहरी छाल के भीतर स्थित रेशेदार ऊतकों से प्राप्त होते हैं। जूट भी इसी व्यापक समूह का महत्त्वपूर्ण उदाहरण है।" },
            { id: 5, tag: "", question: "अबाका का वर्गीकरण किस समूह में करना सर्वाधिक उपयुक्त होगा?", options: ["A. पत्ती से प्राप्त वनस्पति रेशा", "B. तने से प्राप्त वनस्पति रेशा", "C. बीज से प्राप्त वनस्पति रेशा", "D. फल से प्राप्त वनस्पति रेशा"], correct: 0, explanation: "अबाका पत्ती आधारित कठोर वनस्पति रेशा है। इसका उपयोग मुख्यतः ऐसे उत्पादों में किया जाता है जहाँ अपेक्षाकृत मजबूत और टिकाऊ रेशे की आवश्यकता होती है। इसलिए इसे लिनन या जूट जैसे बास्ट रेशों से अलग समझना चाहिए।" },
            { id: 6, tag: "", question: "प्राणी रेशों के रासायनिक व्यवहार को समझने के लिए उनका कौन-सा घटक सर्वाधिक महत्त्वपूर्ण है?", options: ["A. प्रोटीन आधारित बहुलकीय संरचना", "B. सेल्यूलोज आधारित बहुलकीय संरचना", "C. लिग्निन आधारित बहुलकीय संरचना", "D. खनिज आधारित अकार्बनिक संरचना"], correct: 0, explanation: "ऊन और रेशम जैसे प्रमुख प्राणी रेशे प्रोटीन आधारित होते हैं। इसी कारण उनका अम्ल, क्षार, ताप और दहन के प्रति व्यवहार सेल्यूलोज रेशों से अलग होता है। ऊन में मुख्यतः केराटिन तथा रेशम में फाइब्रोइन प्रोटीन पाया जाता है।" },
            { id: 7, tag: "", question: "ऊन और रेशम दोनों प्रोटीन रेशे हैं, फिर भी उनकी सूक्ष्म संरचना अलग होने का प्रमुख कारण क्या है?", options: ["A. उनके प्रोटीन की संरचना और निर्माण प्रक्रिया भिन्न है", "B. उनके सेल्यूलोज की संरचना और मात्रा भिन्न है", "C. उनके खनिज घटकों की मात्रा और प्रकार भिन्न हैं", "D. उनके वनस्पति स्रोत और प्राप्ति स्थान भिन्न हैं"], correct: 0, explanation: "दोनों प्रोटीन आधारित होने के बावजूद ऊन केराटिन से बना होता है और इसकी सतह पर शल्क पाए जाते हैं। रेशम मुख्यतः फाइब्रोइन से बना सतत फिलामेंट है और अपेक्षाकृत चिकना दिखाई देता है। इसलिए केवल प्रोटीन रेशा कहना उनकी पूरी संरचनात्मक समानता नहीं दर्शाता।" },
            { id: 8, tag: "", question: "मानव निर्मित रेशों में पुनर्योजित रेशे की सबसे उपयुक्त पहचान क्या है?", options: ["A. प्राकृतिक बहुलक को घोलकर पुनः रेशा बनाया जाता है", "B. छोटे अणुओं से नया बहुलक बनाकर रेशा बनाया जाता है", "C. प्राकृतिक रेशे को केवल काटकर महीन बनाया जाता है", "D. दो प्राकृतिक रेशों को मिलाकर नया रेशा बनाया जाता है"], correct: 0, explanation: "पुनर्योजित रेशों में मूल बहुलक प्राकृतिक स्रोत से प्राप्त होता है, लेकिन उसे रासायनिक प्रक्रिया से घोलकर पुनः रेशे के रूप में बनाया जाता है। विस्कोस रेयॉन इसका प्रमुख उदाहरण है। यह विशेषता इसे पूर्ण संश्लेषित रेशों से अलग करती है।" },
            { id: 9, tag: "", question: "निम्न में से कौन-सा वर्गीकरण बहुलक की उत्पत्ति के आधार पर सबसे अधिक उपयुक्त है?", options: ["A. प्राकृतिक, पुनर्योजित और संश्लेषित रेशे", "B. महीन, मध्यम और मोटे रेशे", "C. छोटे, लंबे और सतत रेशे", "D. चमकीले, मंद और अपारदर्शी रेशे"], correct: 0, explanation: "बहुलक की उत्पत्ति को ध्यान में रखते हुए रेशों को प्राकृतिक, प्राकृतिक बहुलक से पुनर्योजित तथा रासायनिक संश्लेषण से निर्मित रेशों में समझा जा सकता है। अन्य विकल्प मुख्यतः भौतिक विशेषताओं पर आधारित वर्गीकरण प्रस्तुत करते हैं।" },
            { id: 10, tag: "", question: "स्टेपल और फिलामेंट रेशों के बीच मूल अंतर मुख्यतः किस गुण से संबंधित है?", options: ["A. रेशे की उपलब्ध लंबाई से", "B. रेशे की रासायनिक संरचना से", "C. रेशे की नमी क्षमता से", "D. रेशे की ताप सहनशीलता से"], correct: 0, explanation: "स्टेपल रेशों की लंबाई सीमित होती है, जबकि फिलामेंट रेशे बहुत लंबी या सतत लंबाई में उपलब्ध हो सकते हैं। कपास प्राकृतिक स्टेपल रेशा है, जबकि प्राकृतिक रेशम फिलामेंट रेशे का प्रमुख उदाहरण है।" },
            { id: 11, tag: "", question: "यदि किसी फिलामेंट रेशे को छोटी निर्धारित लंबाइयों में काट दिया जाए, तो उसका उपयोग मुख्यतः किस रूप में किया जा सकता है?", options: ["A. स्टेपल रेशे के समान", "B. खनिज रेशे के समान", "C. बास्ट रेशे के समान", "D. पत्ती रेशे के समान"], correct: 0, explanation: "मानव निर्मित फिलामेंटों को छोटी लंबाई में काटकर स्टेपल रूप दिया जा सकता है। इसके बाद उन्हें कपास या ऊन जैसे स्टेपल रेशों की तरह कताई द्वारा धागे में परिवर्तित किया जा सकता है। इससे मिश्रित धागों का निर्माण भी संभव होता है।" },
            { id: 12, tag: "", question: "रेशे की महीनता बढ़ने पर समान भार में सामान्यतः क्या परिवर्तन अपेक्षित होता है?", options: ["A. रेशों की संख्या अधिक हो सकती है", "B. रेशों की संख्या कम हो सकती है", "C. रेशों की संख्या सदैव समान रहती है", "D. रेशों की संख्या निर्धारित नहीं होती"], correct: 0, explanation: "महीन रेशों का प्रति इकाई लंबाई भार कम होता है। इसलिए समान कुल भार में मोटे रेशों की तुलना में महीन रेशों की संख्या अधिक हो सकती है। महीनता वस्त्र की कोमलता, आवरण क्षमता और धागे की गुणवत्ता को भी प्रभावित करती है।" },
            { id: 13, tag: "", question: "रेशे की क्रिम्प मुख्यतः किस गुण को प्रभावित करने में सहायक होती है?", options: ["A. संसक्ति और आयतन को", "B. घुलनशीलता और ज्वलन को", "C. रंग और रासायनिक संरचना को", "D. घनत्व और गलनांक को"], correct: 0, explanation: "क्रिम्प रेशे में उपस्थित लहरदार या घुँघराली संरचना है। इससे रेशे एक-दूसरे को बेहतर पकड़ सकते हैं और धागे में संसक्ति बढ़ती है। साथ ही रेशों के बीच वायु स्थान बढ़ने से आयतन और ऊष्मा रोधन में भी योगदान मिल सकता है।" },
            { id: 14, tag: "", question: "किसी रेशे की मजबूती की अधिक वैज्ञानिक तुलना के लिए केवल टूटने वाला भार पर्याप्त क्यों नहीं है?", options: ["A. रेशों की महीनता में अंतर परिणाम प्रभावित कर सकता है", "B. रेशों का रंग परिणाम को पूर्णतः बदल सकता है", "C. रेशों की चमक परिणाम को पूर्णतः बदल सकती है", "D. रेशों की उत्पत्ति परिणाम को अप्रासंगिक बनाती है"], correct: 0, explanation: "मोटे रेशे केवल अधिक पदार्थ होने के कारण अधिक भार सह सकते हैं। इसलिए विभिन्न महीनता वाले रेशों की तुलना करते समय मजबूती को उनकी रैखिक घनता के संदर्भ में देखना अधिक सार्थक होता है। इससे वास्तविक रेशा-शक्ति की बेहतर तुलना होती है।" },
            { id: 15, tag: "", question: "टूटने से पहले रेशा जितना लंबा हो सकता है, उस परिवर्तन को किस गुण से सबसे सीधे जोड़ा जाएगा?", options: ["A. प्रसार क्षमता", "B. नमी पुनर्प्राप्ति", "C. घर्षण प्रतिरोध", "D. प्रकाश स्थायित्व"], correct: 0, explanation: "खिंचाव देने पर रेशा टूटने से पहले अपनी मूल लंबाई से जितना बढ़ता है, वह उसकी प्रसार क्षमता को दर्शाता है। यह प्रत्यास्थता से संबंधित अवश्य है, लेकिन दोनों समान गुण नहीं हैं। प्रत्यास्थता खिंचाव हटाने के बाद मूल अवस्था में लौटने की क्षमता है।" },
            { id: 16, tag: "", question: "दो रेशों में समान प्रसार क्षमता होने पर भी उनकी प्रत्यास्थ पुनर्प्राप्ति अलग क्यों हो सकती है?", options: ["A. खिंचाव के बाद वापस लौटने की क्षमता अलग हो सकती है", "B. खिंचाव के समय दोनों की लंबाई सदैव समान होती है", "C. दोनों की रासायनिक संरचना अनिवार्यतः समान होती है", "D. दोनों की नमी ग्रहण क्षमता अनिवार्यतः समान होती है"], correct: 0, explanation: "प्रसार यह बताता है कि रेशा टूटने से पहले कितना खिंच सकता है, जबकि प्रत्यास्थ पुनर्प्राप्ति बताती है कि तनाव हटाने के बाद वह कितना वापस लौटता है। इसलिए अधिक खिंचने वाला रेशा आवश्यक नहीं कि अच्छी तरह मूल अवस्था में भी लौटे।" },
            { id: 17, tag: "", question: "नमी पुनर्प्राप्ति का निर्धारण मुख्यतः किस तुलना पर आधारित होता है?", options: ["A. अवशोषित नमी और शुष्क भार की तुलना पर", "B. गीले भार और प्रारंभिक लंबाई की तुलना पर", "C. सूखे भार और अंतिम लंबाई की तुलना पर", "D. अवशोषित नमी और रेशे की मोटाई की तुलना पर"], correct: 0, explanation: "नमी पुनर्प्राप्ति रेशे में उपस्थित नमी की मात्रा को उसके पूर्ण शुष्क भार के सापेक्ष व्यक्त करती है। यह रेशे की आर्द्रताग्राही प्रकृति के अध्ययन में उपयोगी माप है और वस्त्रों के व्यापारिक भार पर भी इसका प्रभाव पड़ सकता है।" },
            { id: 18, tag: "", question: "नमी मात्रा और नमी पुनर्प्राप्ति में मूल अंतर किस संदर्भ भार के कारण उत्पन्न होता है?", options: ["A. एक में नम भार और दूसरे में शुष्क भार", "B. एक में रेशा भार और दूसरे में धागा भार", "C. एक में कपड़ा भार और दूसरे में रेशा भार", "D. एक में प्रारंभिक भार और दूसरे में रंग भार"], correct: 0, explanation: "नमी मात्रा की गणना में नमी को नम अवस्था के कुल भार के संदर्भ में देखा जाता है, जबकि नमी पुनर्प्राप्ति में नमी की मात्रा को पूर्ण शुष्क भार के सापेक्ष व्यक्त किया जाता है। इसी कारण समान नमूने के लिए दोनों प्रतिशत समान नहीं होते।" },
            { id: 19, tag: "", question: "वस्त्र परीक्षण से पहले नमूनों का मानक वातावरण में अनुकूलन क्यों किया जाता है?", options: ["A. नमी के कारण होने वाली परीक्षण भिन्नता कम करने के लिए", "B. रेशों का प्राकृतिक रंग स्थायी रूप से बदलने के लिए", "C. वस्त्र की बुनाई को अधिक सघन बनाने के लिए", "D. नमूने का वास्तविक भार स्थायी रूप से घटाने के लिए"], correct: 0, explanation: "कई वस्त्र रेशे वातावरण की आर्द्रता के अनुसार नमी ग्रहण या त्यागते हैं। इससे उनका भार, मजबूती और अन्य गुण प्रभावित हो सकते हैं। इसलिए तुलनीय एवं पुनरुत्पाद्य परिणामों के लिए परीक्षण से पहले नियंत्रित वातावरण में नमूने को संतुलित करना महत्त्वपूर्ण है।" },
            { id: 20, tag: "", question: "यदि परीक्षण नमूने अलग-अलग आर्द्रता की परिस्थितियों में रखे गए हों, तो किस परिणाम की विश्वसनीयता विशेष रूप से प्रभावित हो सकती है?", options: ["A. भार और यांत्रिक गुणों की", "B. केवल मूल रंग पहचान की", "C. केवल बुनाई के प्रकार की", "D. केवल रेशे के स्रोत की"], correct: 0, explanation: "आर्द्रताग्राही रेशों में वातावरण की नमी से भार बदल सकता है और कई यांत्रिक गुण भी प्रभावित हो सकते हैं। इसलिए बिना अनुकूलन किए प्राप्त परिणामों की तुलना भ्रामक हो सकती है।" },
            { id: 21, tag: "", question: "किसी रेशे के अनुप्रस्थ काट का परीक्षण मुख्यतः किस जानकारी में सहायक होता है?", options: ["A. रेशे के आकार और आंतरिक संरचना में", "B. रेशे की वास्तविक ज्वलन गति में", "C. रेशे की वास्तविक रंग स्थिरता में", "D. रेशे की वास्तविक तन्य शक्ति में"], correct: 0, explanation: "अनुप्रस्थ काट से रेशे का क्रॉस-सेक्शनल आकार, ल्यूमेन या अन्य आंतरिक संरचनाएँ देखी जा सकती हैं। यह विशेष रूप से उन रेशों की पहचान में सहायक है जिनकी अनुदैर्ध्य आकृति अकेले निर्णायक नहीं होती।" },
            { id: 22, tag: "", question: "कपास की परिपक्वता का सूक्ष्म परीक्षण करते समय किस संरचना का अध्ययन विशेष उपयोगी हो सकता है?", options: ["A. कोशिका भित्ति और ल्यूमेन का", "B. बाहरी शल्क और मेडुला का", "C. सतही गाँठ और फाइब्रोइन का", "D. बाहरी छाल और केराटिन का"], correct: 0, explanation: "कपास एक विकसित बीज रोम है। उसकी परिपक्वता के साथ द्वितीयक कोशिका भित्ति में सेल्यूलोज का निक्षेप बढ़ता है और ल्यूमेन का अनुपात बदलता है। इसलिए कोशिका भित्ति और ल्यूमेन का अध्ययन परिपक्वता समझने में उपयोगी है।" },
            { id: 23, tag: "", question: "ऊन के रेशे में मेडुला की उपस्थिति मुख्यतः किस प्रकार के रेशों में अधिक स्पष्ट हो सकती है?", options: ["A. अपेक्षाकृत मोटे ऊन रेशों में", "B. अत्यधिक महीन ऊन रेशों में", "C. सभी ऊन रेशों में समान रूप से", "D. केवल कृत्रिम ऊन रेशों में"], correct: 0, explanation: "सभी ऊन रेशों में मेडुला स्पष्ट नहीं होता। अपेक्षाकृत मोटे या विशेष प्रकार के बालों में यह अधिक विकसित हो सकता है, जबकि बहुत महीन ऊन में यह अनुपस्थित या अत्यल्प हो सकता है। इसलिए मेडुला को अकेले ऊन की सार्वभौमिक पहचान नहीं मानना चाहिए।" },
            { id: 24, tag: "", question: "रेशम के कच्चे फिलामेंट से सेरिसिन हटाने की प्रक्रिया का प्रमुख प्रभाव क्या होता है?", options: ["A. रेशा अधिक कोमल और चमकीला हो जाता है", "B. रेशा अधिक शल्कयुक्त और खुरदरा हो जाता है", "C. रेशा अधिक गाँठदार और कठोर हो जाता है", "D. रेशा अधिक मोटा और अपारदर्शी हो जाता है"], correct: 0, explanation: "कच्चे रेशम में फाइब्रोइन तंतुओं के चारों ओर सेरिसिन नामक गोंद जैसा प्रोटीन होता है। इसे हटाने की प्रक्रिया से रेशम की कोमलता, चमक और स्पर्श गुण बेहतर होते हैं। इस प्रक्रिया को रेशम की पहचान एवं गुणों को समझते समय ध्यान में रखना आवश्यक है।" },
            { id: 25, tag: "", question: "यदि किसी रेशे की पहचान में सूक्ष्मदर्शी आकृति स्पष्ट न हो, तो वैज्ञानिक रूप से अगला सबसे उपयुक्त दृष्टिकोण क्या होगा?", options: ["A. पूरक भौतिक और रासायनिक परीक्षण करना", "B. केवल रेशे के बाजार मूल्य को देखना", "C. केवल वस्त्र के व्यापारिक नाम को देखना", "D. केवल वस्त्र के रंग और चमक को देखना"], correct: 0, explanation: "रेशा पहचान में किसी एक परीक्षण पर निर्भरता उचित नहीं है। परिसज्जा, मिश्रण या निर्माण प्रक्रिया से बाहरी और सूक्ष्म रूप बदल सकता है। इसलिए घुलनशीलता, दहन तथा अन्य उपयुक्त परीक्षणों से निष्कर्ष की पुष्टि करनी चाहिए।" },
            { id: 26, tag: "", question: "दहन परीक्षण करते समय लौ के निकट रेशे के व्यवहार को अलग से देखने का कारण क्या है?", options: ["A. पिघलने, सिकुड़ने या प्रज्वलित होने की प्रवृत्ति जानना", "B. केवल रेशे की प्राकृतिक लंबाई निर्धारित करना", "C. केवल रेशे की वास्तविक महीनता निर्धारित करना", "D. केवल रेशे की नमी पुनर्प्राप्ति निर्धारित करना"], correct: 0, explanation: "दहन परीक्षण केवल गंध या राख देखने तक सीमित नहीं है। रेशा लौ के पास आते ही सिकुड़ता है, पिघलता है या सीधे प्रज्वलित होता है—ये सभी पहचान के महत्त्वपूर्ण संकेत हैं। लौ से हटाने के बाद जलने का व्यवहार भी देखा जाता है।" },
            { id: 27, tag: "", question: "किसी अज्ञात रेशे के दहन परीक्षण में स्वयं बुझने की प्रवृत्ति दिखाई दे, तो निष्कर्ष निकालते समय क्या करना चाहिए?", options: ["A. अन्य पहचान परीक्षणों से भी परिणाम की पुष्टि करनी चाहिए", "B. उसे निश्चित रूप से ऊन घोषित कर देना चाहिए", "C. उसे निश्चित रूप से रेशम घोषित कर देना चाहिए", "D. उसे निश्चित रूप से सेल्यूलोज घोषित कर देना चाहिए"], correct: 0, explanation: "दहन का एक अकेला लक्षण निर्णायक पहचान के लिए पर्याप्त नहीं होता। परिसज्जा, मिश्रण और रासायनिक उपचार भी दहन व्यवहार बदल सकते हैं। इसलिए गंध, अवशेष, सूक्ष्म संरचना और आवश्यकतानुसार रासायनिक परीक्षण को संयुक्त रूप से देखना चाहिए।" },
            { id: 28, tag: "", question: "रासायनिक घुलनशीलता परीक्षण मिश्रित रेशों के विश्लेषण में विशेष रूप से उपयोगी क्यों होता है?", options: ["A. विभिन्न रेशों की रासायनिक प्रतिक्रिया भिन्न हो सकती है", "B. सभी रेशों की रासायनिक प्रतिक्रिया समान होती है", "C. केवल प्राकृतिक रेशे रसायनों से प्रतिक्रिया करते हैं", "D. केवल संश्लेषित रेशे रसायनों से प्रतिक्रिया करते हैं"], correct: 0, explanation: "अलग-अलग बहुलकों की रासायनिक संरचना अलग होती है, इसलिए विशिष्ट विलायकों या अभिकर्मकों के प्रति उनका व्यवहार भी भिन्न होता है। इसी चयनात्मक व्यवहार का उपयोग मिश्रण में रेशों की पहचान तथा कुछ परिस्थितियों में मात्रात्मक निर्धारण के लिए किया जाता है।" },
            { id: 29, tag: "", question: "अम्ल और क्षार के प्रति रेशों की प्रतिक्रिया का अध्ययन करते समय सबसे महत्त्वपूर्ण कारक कौन-सा है?", options: ["A. रेशे की मूल रासायनिक संरचना", "B. रेशे का केवल व्यापारिक मूल्य", "C. रेशे का केवल प्राकृतिक रंग", "D. रेशे का केवल बाहरी आकार"], correct: 0, explanation: "सेल्यूलोज, प्रोटीन, पॉलियामाइड और पॉलिएस्टर जैसे बहुलकों के रासायनिक बंध अलग होते हैं। इसलिए अम्ल और क्षार के प्रति उनकी स्थिरता समान नहीं होती। यही कारण है कि धुलाई और परिसज्जा में रेशे के प्रकार के अनुसार रसायनों का चयन किया जाता है।" },
            { id: 30, tag: "", question: "प्रोटीन रेशों पर प्रबल क्षार का प्रयोग सामान्यतः अधिक हानिकारक क्यों हो सकता है?", options: ["A. क्षार प्रोटीन संरचना को क्षतिग्रस्त कर सकता है", "B. क्षार सेल्यूलोज संरचना को प्रोटीन में बदल देता है", "C. क्षार रेशे में अतिरिक्त शल्क उत्पन्न कर देता है", "D. क्षार रेशे को पूर्णतः खनिज पदार्थ बना देता है"], correct: 0, explanation: "ऊन और रेशम जैसे प्रोटीन रेशों में पेप्टाइड बंध तथा अन्य संवेदनशील संरचनाएँ होती हैं। प्रबल क्षारीय परिस्थितियाँ इन संरचनाओं को नुकसान पहुँचा सकती हैं। इसलिए प्रोटीन वस्त्रों की धुलाई और रासायनिक उपचार में क्षार की तीव्रता पर विशेष ध्यान दिया जाता है।" },
            { id: 31, tag: "", question: "किसी वस्त्र की तन्य शक्ति जाँचते समय नमूने की चौड़ाई और परीक्षण लंबाई को नियंत्रित रखना क्यों आवश्यक है?", options: ["A. परिणामों को तुलनीय और पुनरुत्पाद्य बनाने के लिए", "B. वस्त्र का प्राकृतिक रंग स्थिर रखने के लिए", "C. रेशे का रासायनिक वर्ग बदलने के लिए", "D. वस्त्र की नमी क्षमता बढ़ाने के लिए"], correct: 0, explanation: "परीक्षण नमूनों का आकार बदलने पर टूटने के लिए आवश्यक बल भी बदल सकता है। मानकीकृत नमूना आयाम और परीक्षण परिस्थितियाँ विभिन्न नमूनों के परिणामों की निष्पक्ष तुलना में सहायता करती हैं।" },
            { id: 32, tag: "", question: "वस्त्र की बर्स्टिंग शक्ति का परीक्षण किस प्रकार के तनाव को समझने में विशेष उपयोगी है?", options: ["A. अनेक दिशाओं से पड़ने वाले दबाव को", "B. केवल लंबाई दिशा के खिंचाव को", "C. केवल चौड़ाई दिशा के खिंचाव को", "D. केवल सतही घर्षण के प्रभाव को"], correct: 0, explanation: "बर्स्टिंग परीक्षण में कपड़े पर एक क्षेत्र में अनेक दिशाओं से तनाव उत्पन्न किया जाता है। यह विशेष रूप से बुने हुए कुछ वस्त्रों और निटेड वस्त्रों के लिए उपयोगी है, जहाँ वास्तविक उपयोग में बल केवल एक सीधी दिशा में नहीं लगता।" },
            { id: 33, tag: "", question: "निटेड वस्त्र के परीक्षण में केवल एक दिशा की तन्य शक्ति की अपेक्षा बर्स्टिंग शक्ति अधिक उपयोगी क्यों हो सकती है?", options: ["A. उपयोग के समय तनाव अनेक दिशाओं में फैल सकता है", "B. निटेड वस्त्र में रेशे बिल्कुल उपस्थित नहीं होते", "C. निटेड वस्त्र केवल लंबाई दिशा में फैलता है", "D. निटेड वस्त्र पर घर्षण का कोई प्रभाव नहीं होता"], correct: 0, explanation: "निटेड संरचना लूपों से बनी होती है और बल लगने पर कई दिशाओं में विकृत हो सकती है। इसलिए क्षेत्रीय बहुदिशीय तनाव के प्रति उसका व्यवहार समझने के लिए बर्स्टिंग शक्ति उपयोगी परीक्षण है।" },
            { id: 34, tag: "", question: "वस्त्र की ड्रेप क्षमता का संबंध मुख्यतः किस व्यवहार से है?", options: ["A. लटकने पर बनने वाली तहों के स्वरूप से", "B. खींचने पर टूटने वाले अधिकतम बल से", "C. रगड़ने पर होने वाली सतही क्षति से", "D. धुलाई में होने वाले रंग स्थानांतरण से"], correct: 0, explanation: "ड्रेप वस्त्र के अपने भार के प्रभाव में लटकने और सुंदर तहें बनाने के व्यवहार को दर्शाता है। यह रेशे, धागे, बुनाई, मोटाई, भार और परिसज्जा जैसे कई कारकों से प्रभावित होता है।" },
            { id: 35, tag: "", question: "वस्त्र की कठोरता का मूल्यांकन मुख्यतः किस उपयोगी गुण से संबंधित है?", options: ["A. मोड़ने के प्रतिरोध और लचीलेपन से", "B. रंग छोड़ने और रंग ग्रहण करने से", "C. नमी सोखने और नमी छोड़ने से", "D. जलने और पिघलने की प्रवृत्ति से"], correct: 0, explanation: "कठोरता वस्त्र के मोड़ने के प्रतिरोध को दर्शाती है। अधिक कठोर वस्त्र सामान्यतः कम सहजता से मुड़ता और लटकता है। इस गुण का परिधान की ड्रेप, हैंडल और उपयोगिता से निकट संबंध है।" },
            { id: 36, tag: "", question: "वस्त्र की क्रीज रिकवरी का परीक्षण मुख्यतः किस क्षमता को मापता है?", options: ["A. मोड़ के बाद पूर्व अवस्था में लौटने की क्षमता", "B. धुलाई के बाद रंग बनाए रखने की क्षमता", "C. घर्षण के बाद भार बनाए रखने की क्षमता", "D. प्रकाश के बाद चमक बनाए रखने की क्षमता"], correct: 0, explanation: "वस्त्र को मोड़ने या दबाने से क्रीज बनती है। दबाव हटने के बाद वस्त्र जितनी अच्छी तरह अपनी मूल अवस्था की ओर लौटता है, उसकी क्रीज रिकवरी उतनी बेहतर मानी जाती है। यह रेशा और परिसज्जा दोनों से प्रभावित हो सकती है।" },
            { id: 37, tag: "", question: "कपड़े की वायु पारगम्यता मुख्यतः किस विशेषता का संकेत देती है?", options: ["A. कपड़े से वायु गुजरने की क्षमता", "B. कपड़े से प्रकाश गुजरने की क्षमता", "C. कपड़े से रंग निकलने की क्षमता", "D. कपड़े से रेशा निकलने की क्षमता"], correct: 0, explanation: "वायु पारगम्यता वस्त्र संरचना में उपलब्ध छिद्रों और वायु प्रवाह से संबंधित है। धागे की सघनता, बुनाई, मोटाई और परिसज्जा इसे प्रभावित कर सकती है। गर्म मौसम के वस्त्रों में यह आराम से जुड़ा महत्त्वपूर्ण गुण है।" },
            { id: 38, tag: "", question: "समान प्रकार के धागे से बने दो वस्त्रों में अधिक सघन वस्त्र की वायु पारगम्यता सामान्यतः कैसी होने की संभावना है?", options: ["A. अपेक्षाकृत कम होने की संभावना है", "B. अपेक्षाकृत अधिक होने की संभावना है", "C. अनिवार्य रूप से समान रहने की संभावना है", "D. अनिवार्य रूप से शून्य होने की संभावना है"], correct: 0, explanation: "अधिक सघन संरचना में धागों के बीच खाली स्थान सामान्यतः कम होते हैं, जिससे वायु का प्रवाह घट सकता है। हालांकि वास्तविक परिणाम धागे, मोटाई और परिसज्जा जैसे अन्य कारकों से भी प्रभावित होता है।" },
            { id: 39, tag: "", question: "जल अवशोषण और जल विकर्षण को समान गुण नहीं माना जा सकता क्योंकि जल विकर्षण मुख्यतः क्या दर्शाता है?", options: ["A. सतह द्वारा जल प्रवेश का विरोध", "B. रेशे द्वारा जलवाष्प ग्रहण करना", "C. वस्त्र द्वारा रंग ग्रहण करना", "D. रेशे द्वारा ताप ग्रहण करना"], correct: 0, explanation: "जल विकर्षण वस्त्र की सतह पर तरल जल के प्रवेश को रोकने या विलंबित करने की क्षमता से जुड़ा है। यह नमी पुनर्प्राप्ति से अलग अवधारणा है, क्योंकि नमी पुनर्प्राप्ति मुख्यतः वातावरण की जलवाष्प से संबंधित होती है।" },
            { id: 40, tag: "", question: "पिलिंग परीक्षण में वस्त्र की सतह पर बने छोटे गोलों की स्थिरता किस कारण अधिक हो सकती है?", options: ["A. बाहर निकले रेशे मजबूत होने पर", "B. बाहर निकले रेशे तुरंत घुलने पर", "C. बाहर निकले रेशे अत्यधिक भंगुर होने पर", "D. बाहर निकले रेशे तुरंत टूटने पर"], correct: 0, explanation: "पिलिंग में पहले सतह के रेशे बाहर निकलकर उलझते हैं और छोटे गोले बनाते हैं। यदि ये रेशे मजबूत हैं और आसानी से टूटते नहीं, तो बने हुए पिल्स लंबे समय तक सतह पर टिक सकते हैं। कुछ मजबूत संश्लेषित रेशों में यह समस्या अधिक स्पष्ट हो सकती है।" },
            { id: 41, tag: "", question: "घर्षण परीक्षण में भार हानि का अध्ययन किस निष्कर्ष के लिए विशेष उपयोगी हो सकता है?", options: ["A. रगड़ से होने वाले पदार्थ क्षय के लिए", "B. नमी से होने वाले रंग परिवर्तन के लिए", "C. प्रकाश से होने वाले रंग परिवर्तन के लिए", "D. ताप से होने वाले आयामी परिवर्तन के लिए"], correct: 0, explanation: "लगातार रगड़ से वस्त्र की सतह के रेशे और धागे क्षतिग्रस्त हो सकते हैं। परीक्षण से पहले और बाद के भार या अन्य संरचनात्मक परिवर्तनों की तुलना करके घर्षण से हुए क्षय का आकलन किया जा सकता है।" },
