        // 2. 50 प्रश्नों का डेटासेट (बिना किसी टैग के)
        const dataset = [
            { id: 1, tag: "", question: "गर्भावस्था के दौरान प्रोटीन की आवश्यकता बढ़ने का सबसे व्यापक कारण कौन-सा है?", options: ["केवल मातृ शरीर में वसा का संचय", "भ्रूणीय ऊतकों के निर्माण के साथ मातृ ऊतकों में होने वाले परिवर्तनों की पूर्ति", "केवल रक्त में ग्लूकोज का नियमन", "केवल कैल्शियम के अवशोषण को बढ़ाना"], correct: 1, explanation: "गर्भावस्था में भ्रूण के विकास के साथ placenta, maternal tissues तथा रक्त आदि में भी परिवर्तन होते हैं। इसलिए protein requirement बढ़ती है।" },
            { id: 2, tag: "", question: "गर्भावस्था में बढ़ी हुई प्रोटीन आवश्यकता को पूरा करने के लिए निम्न में से कौन-सा संयोजन सबसे उपयुक्त है?", options: ["चावल + चीनी + तेल", "दाल + दूध/दही + सोयाबीन/अंडा", "फल + शर्करा + चाय", "सब्जियाँ + नमक + तेल"], correct: 1, explanation: "दाल, दूध, सोयाबीन और अंडा जैसे खाद्य पदार्थ protein के अच्छे स्रोत हैं। विविध स्रोतों का संयोजन protein adequacy बेहतर करता है।" },
            { id: 3, tag: "", question: "ICMR-NIN 2020 के अनुसार pregnancy में protein की अतिरिक्त RDA किस प्रकार बदलती है?", options: ["दूसरे trimester में +9.5 g और तीसरे में +22 g/day", "दूसरे trimester में +22 g और तीसरे में +9.5 g/day", "दोनों trimester में +5 g/day", "केवल पहले trimester में +22 g/day"], correct: 0, explanation: "ICMR-NIN 2020 में second trimester के लिए +9.5 g/day और third trimester के लिए +22 g/day अतिरिक्त protein RDA दी गई है।" },
            { id: 4, tag: "", question: "गर्भावस्था में iron की आवश्यकता बढ़ने का सबसे सीधा संबंध किससे है?", options: ["केवल मांसपेशीय वृद्धि", "बढ़ी हुई रक्त-निर्माण एवं haemoglobin आवश्यकता", "केवल वसा के पाचन", "केवल calcium deposition"], correct: 1, explanation: "गर्भावस्था में maternal blood volume तथा fetal requirements के कारण iron की आवश्यकता बढ़ती है।" },
            { id: 5, tag: "", question: "ICMR-NIN 2020 के अनुसार pregnant women के लिए iron RDA क्या है?", options: ["21 mg/day", "24 mg/day", "27 mg/day", "35 mg/day"], correct: 2, explanation: "ICMR-NIN 2020 में pregnancy के लिए iron RDA 27 mg/day है।" },
            { id: 6, tag: "", question: "गर्भावस्था में iron deficiency का सबसे प्रत्यक्ष परिणाम निम्न में से कौन-सा है?", options: ["Pellagra", "Iron-deficiency anaemia", "Scurvy", "Rickets"], correct: 1, explanation: "Iron haemoglobin synthesis का महत्वपूर्ण घटक है। इसकी कमी से iron-deficiency anaemia हो सकता है।" },
            { id: 7, tag: "", question: "गर्भावस्था में folate का महत्व मुख्यतः किस प्रक्रिया से संबंधित है?", options: ["कोशिका-विभाजन एवं fetal development", "केवल dietary fat digestion", "केवल calcium excretion", "केवल blood glucose storage"], correct: 0, explanation: "Folate तीव्र cell division और fetal development के लिए महत्वपूर्ण है, विशेषकर pregnancy के प्रारंभिक चरण में।" },
