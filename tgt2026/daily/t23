            { id: 10, tag: "", question: "ICMR-NIN 2020 के अनुसार pregnancy में calcium की RDA लगभग कितनी है?", options: ["600 mg/day", "800 mg/day", "1000 mg/day", "1500 mg/day"], correct: 2, explanation: "ICMR-NIN 2020 में pregnancy के लिए calcium RDA 1000 mg/day है।" },
            { id: 11, tag: "", question: "गर्भावस्था में energy requirement के संदर्भ में ICMR-NIN 2020 का सही कथन कौन-सा है?", options: ["pregnancy में कोई अतिरिक्त energy नहीं चाहिए", "सभी महिलाओं के लिए निश्चित रूप से +500 kcal/day", "सामान्यतः +350 kcal/day का अतिरिक्त प्रावधान किया गया है", "केवल पहले trimester में +350 kcal/day"], correct: 2, explanation: "ICMR-NIN 2020 में pregnancy के लिए +350 kcal/day दिया गया है; वास्तविक आवश्यकता body weight, weight gain और activity के अनुसार adjust की जाती है।" },
            { id: 12, tag: "", question: "गर्भावस्था में “दो व्यक्तियों के लिए खाना” कहने का वैज्ञानिक अर्थ क्या होना चाहिए?", options: ["भोजन की मात्रा को ठीक दोगुना करना", "केवल protein को दोगुना करना", "बढ़ी हुई nutrient requirements के अनुसार diet की गुणवत्ता और मात्रा को समायोजित करना", "केवल दूध की मात्रा दोगुनी करना"], correct: 2, explanation: "Pregnancy में requirements बढ़ती हैं, लेकिन इसका अर्थ सामान्य भोजन की मात्रा को mechanically दो गुना करना नहीं है।" },
            { id: 13, tag: "", question: "गर्भावस्था में protein-rich foods के चयन के संदर्भ में निम्न में से कौन-सा विकल्प अधिक उपयुक्त है?", options: ["केवल refined cereals", "pulses, milk, egg/appropriate animal foods और soybean जैसे विविध स्रोत", "केवल fruit juices", "केवल sugar-containing foods"], correct: 1, explanation: "विविध protein sources maternal और fetal requirements पूरी करने में सहायता करते हैं।" },
            { id: 14, tag: "", question: "गर्भावस्था में iodine की पर्याप्तता विशेष रूप से किससे जुड़ी है?", options: ["thyroid hormone synthesis और fetal development", "केवल fat storage", "केवल digestion", "केवल haemoglobin breakdown"], correct: 0, explanation: "Iodine thyroid hormones के निर्माण के लिए आवश्यक है और ये fetal growth तथा neurological development में महत्वपूर्ण हैं।" },
            { id: 15, tag: "", question: "गर्भावस्था में भोजन की dietary diversity क्यों महत्वपूर्ण है?", options: ["इससे केवल भोजन का रंग बदलता है", "इससे विभिन्न आवश्यक nutrients की adequacy की संभावना बढ़ती है", "इससे केवल calories बढ़ती हैं", "इससे protein की आवश्यकता समाप्त हो जाती है"], correct: 1, explanation: "अलग-अलग food groups से protein, vitamins, minerals, essential fatty acids आदि प्राप्त होते हैं।" },
            { id: 16, tag: "", question: "गर्भवती महिला के लिए निम्न में से कौन-सा meal pattern अधिक उपयुक्त होगा?", options: ["केवल cereal-based meals", "cereal + pulse + vegetable + fruit + milk/other protein source का विविध संयोजन", "केवल fruit diet", "केवल high-fat foods"], correct: 1, explanation: "विविध food groups को शामिल करने से overall nutrient adequacy बेहतर होती है।" },
            { id: 17, tag: "", question: "यदि गर्भवती महिला में iron-rich food का सेवन पर्याप्त है लेकिन भोजन के साथ बार-बार चाय ली जाती है, तो किस nutrient की bioavailability प्रभावित हो सकती है?", options: ["Non-heme iron", "Vitamin B12", "Vitamin D", "Iodine"], correct: 0, explanation: "Tea में उपस्थित polyphenolic compounds non-heme iron absorption को कम कर सकते हैं।" },
            { id: 18, tag: "", question: "गर्भावस्था में protein की आवश्यकता बढ़ने के पीछे निम्न में से कौन-सा कारण सबसे कम उपयुक्त है?", options: ["भ्रूणीय tissue synthesis", "maternal tissue growth/repair", "नए cellular structures का निर्माण", "केवल शरीर का तापमान बनाए रखना"], correct: 3, explanation: "Protein की बढ़ी आवश्यकता मुख्यतः tissue synthesis, growth और repair से जुड़ी है; केवल body temperature maintenance इसका प्रमुख कारण नहीं है।" },
            { id: 19, tag: "", question: "गर्भावस्था में भोजन की योजना बनाते समय निम्न में से किस सिद्धांत को प्राथमिकता मिलनी चाहिए?", options: ["केवल calorie density", "nutrient density और dietary diversity", "केवल भोजन की कम लागत", "केवल protein concentration"], correct: 1, explanation: "Pregnancy में कई nutrients की आवश्यकता बढ़ती है, इसलिए nutrient-dense और diverse diet अधिक उपयुक्त है।" },
            { id: 20, tag: "", question: "गर्भावस्था में iron, folate और protein को एक साथ पर्याप्त रखने का सबसे उचित कारण क्या है?", options: ["तीनों केवल energy देते हैं", "तीनों maternal तथा fetal growth/development से अलग-अलग लेकिन महत्वपूर्ण रूप से जुड़े हैं", "तीनों केवल digestion में काम करते हैं", "तीनों calcium के substitutes हैं"], correct: 1, explanation: "Protein tissue formation में, iron haemoglobin synthesis में और folate cell division/fetal development में महत्वपूर्ण है।" },
            { id: 21, tag: "", question: "balanced diet की आवश्यकता किस आधार पर निर्धारित होती है?", options: ["केवल आयु", "केवल gender", "आवश्यकता, जिसमें age, gender, activity और health status जैसे कारक शामिल हैं", "केवल भोजन की उपलब्धता"], correct: 2, explanation: "Balanced diet व्यक्ति की physiological requirements पर निर्भर करती है।" },
            { id: 22, tag: "", question: "एक ही आयु की सामान्य महिला और गर्भवती महिला के balanced diet में अंतर का सबसे उचित कारण क्या है?", options: ["दोनों की nutrient requirements हमेशा समान होती हैं", "pregnancy में physiological और nutritional requirements बदलती हैं", "गर्भवती महिला को केवल liquid foods चाहिए", "pregnancy में protein की आवश्यकता समाप्त हो जाती है"], correct: 1, explanation: "Expecting women की balanced diet सामान्य महिलाओं से अलग होती है क्योंकि pregnancy में requirements बदलती हैं।" },
            { id: 23, tag: "", question: "balanced diet के बारे में सही कथन कौन-सा है?", options: ["हर meal में सभी nutrients का होना अनिवार्य है", "हर दिन केवल एक ही food group पर्याप्त है", "food items समय के साथ विविध होने चाहिए ताकि requirements पूरी हों", "अधिक nutrients वाला diet हमेशा बेहतर होता है"], correct: 2, explanation: "Balanced diet का अर्थ प्रत्येक meal में हर nutrient लेना नहीं है; reasonable period में dietary variety महत्वपूर्ण है।" },
