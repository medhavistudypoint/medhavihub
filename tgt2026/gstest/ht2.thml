<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medhavi Study Point - Online Test</title>
    <link rel="stylesheet" href="../../global-style.css?v=3.0">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <!-- 🔒 एक्सेस कंट्रोल कोड -->
    <script>
        const userPlan = localStorage.getItem("user_plan");
        if (userPlan !== "FULL" && userPlan !== "GS") {
            alert("इस टेस्ट को देखने के लिए कृपया पहले लॉगिन करें या GS/FULL बैच जॉइन करें!");
            window.location.href = "../../homescience.html"; 
        }
    </script>
</head>
<body>

    <!-- सुरक्षा वॉटरमार्क स्क्रीन -->
    <div class="watermark-overlay">
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
    </div>

    <!-- 1. लॉगिन गेट स्क्रीन -->
    <div id="boxLoginGate" class="login-card">
        <h2>Medhavi Study Point Test Gate</h2>
        <p>कृपया अपना पूरा नाम दर्ज करें और टेस्ट शुरू करें.</p>
        <input type="text" id="txtStudentName" placeholder="अपना नाम यहाँ लिखें..." required>
        <button class="btn-main-action" onclick="validateAndStartQuiz()">परीक्षा शुरू करें 🚀</button>
        <br><br>
        <a href="../../homescience.html" style="color:#64748b; font-weight:600; text-decoration:none;">🔙 विषय चयन पर वापस जाएं</a>
    </div>

    <!-- 2. परीक्षा वर्कस्पेस स्क्रीन -->
    <div id="quizWorkspace" class="hidden">
        <div class="cbt-header" style="background: #0b1e47; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div class="header-left" style="text-align: center; flex: 1; min-width: 220px;">
                <h1 style="color: #facc15; font-size: clamp(18px, 4.8vw, 28px); font-weight: 900; margin: 0; letter-spacing: 0.5px; white-space: nowrap;">MEDHAVI STUDY POINT</h1>
                <p style="color: #ffffff; font-size: clamp(11px, 2.8vw, 14px); margin: 3px 0 0 0; opacity: 0.95; font-weight: 600; white-space: nowrap;">TGT / PGT / NET / DSSSB</p>
            </div>
            <div class="timer-box" id="countdownTimer" style="background: #1e3a8a; border: 2px solid #3b82f6; color: #facc15; padding: 6px 14px; border-radius: 8px; font-size: 18px; font-weight: 800; letter-spacing: 1px; margin: 0 auto;">40:00</div>
        </div>

        <div class="main-container">
            <div class="card-panel">
                <div class="meta-row">
                    <div>
                        <span class="q-badge">प्रश्न: <span id="lblCurrentNum">1</span> / <span id="lblTotalNum">0</span></span>
                        <span class="subject-badge">विषय (Subject)</span>
                        <span id="lblQuestionTag" class="tag-badge"></span>
                    </div>
                </div>
                <div id="boxQuestionText" class="question-text">प्रश्न लोड हो रहा है...</div>
                <div id="boxOptionsList"></div>
                <div class="btn-tri-grid">
                    <button class="btn btn-prev" onclick="doNavigatePrev()">◀ पिछला</button>
                    <button class="btn btn-clear" onclick="doClearAnswer()">Clear</button>
                    <button class="btn btn-mark" onclick="doToggleMark()">⭐ Mark</button>
                </div>
                <button id="btnMainNav" class="btn-main-action" onclick="handleMainAction()">अगला ▶</button>
            </div>
            <div class="card-panel">
                <div class="palette-heading">प्रश्न पैलेट ग्रिड</div>
                <div id="boxPaletteGrid" class="grid-matrix"></div>
                <button class="btn-submit-trigger" onclick="triggerTestSubmission()">✔ Submit Test</button>
            </div>
        </div>
    </div>

    <!-- 3. रिपोर्ट डैशबोर्ड स्क्रीन -->
    <div id="boxReportDashboard" class="report-view">
        <div id="captureTarget" style="padding: 25px; background: white; border-radius: 12px;">
            <div class="report-header-title">Medhavi Study Point — Result Dashboard</div>
            <p id="lblReportStudentName" style="font-size: 18px; font-weight: bold; text-align: center; color: #0b1e47; margin-bottom: 20px;"></p>
            <div class="grid-5-columns">
                <div class="metric-card-wrapper"><div class="metric-card m-blue"><div id="valNetScore" class="metric-val">0 / 0</div><div class="metric-title">Score</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-green"><div id="valCorrectCount" class="metric-val">0</div><div class="metric-title">Correct</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-red"><div id="valIncorrectCount" class="metric-val">0</div><div class="metric-title">Incorrect</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-orange"><div id="valSkippedCount" class="metric-val">0</div><div class="metric-title">Skipped</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-purple"><div id="valTimeConsumed" class="metric-val">00:00</div><div class="metric-title">Time</div></div></div>
            </div>
        </div>
        <button class="btn-telegram-share" onclick="captureCardAndOpenGroup()">📸 रिजल्ट इमेज कॉपी करें</button>
        <a href="../../homescience.html" class="btn-dashboard-redirect">🔙 मुख्य डैशबोर्ड पर वापस जाएं</a>
        <div id="boxReviewAnswersList"></div>
    </div>

    <!-- 🎯 टेस्ट डेटासेट और QUIZ_KEY (यहाँ अपना डेटा डालें) -->
    <script>
        // 1. इस टेस्ट की यूनिक की (हर नए टेस्ट के लिए इसे बदलें जैसे medhavi_test_25)
        const QUIZ_KEY = "medhavi_custom_test_unique_key"; 

        // 2. अपना प्रश्न डेटासेट यहाँ पेस्ट करें
  const dataset = [
[
    {
        "id": 1,
        "question": "1. आर्यों का भारत में आगमन सामान्यतः किस काल के आसपास माना जाता है? (a) 2500–1800 ई.पू. (b) 2000–1500 ई.पू. (c) 1500–1000 ई.पू. (d) 1000–500 ई.पू.",
        "options": [
            "(a) 2500–1800 ई.पू.",
            "(b) 2000–1500 ई.पू.",
            "(c) 1500–1000 ई.पू.",
            "(d) 1000–500 ई.पू."
        ],
        "correct": 2,
        "explanation": "उत्तर: (c) 1500–1000 ई.पू. | व्याख्या: परंपरागत इतिहास-लेखन में आर्यों के भारत आगमन को लगभग 1500 ई.पू. के आसपास माना गया है और इसे उत्तर-पश्चिमी भारत से जोड़ा जाता है। प्रारंभिक वैदिक संस्कृति का विकास इसी व्यापक कालखंड में हुआ। हालांकि आधुनिक इतिहासलेखन में आर्यों के आगमन/प्रवास की प्रकृति और कालक्रम पर विभिन्न मत हैं, इसलिए इसे निश्चित एकल घटना के रूप में नहीं देखना चाहिए।"
    },
    {
        "id": 2,
        "question": "2. आर्य लोग भारत में मुख्यतः किस क्षेत्र में बसे? (a) पूर्वी यूरोप (b) ऑस्ट्रेलिया (c) मध्य एशिया (d) दक्षिण-पूर्व एशिया",
        "options": [
            "(a) पूर्वी यूरोप",
            "(b) ऑस्ट्रेलिया",
            "(c) मध्य एशिया",
            "(d) दक्षिण-पूर्व एशिया"
        ],
        "correct": 2,
        "explanation": "उत्तर: (c) मध्य एशिया | व्याख्या: पारंपरिक परीक्षा-साहित्य में आर्यों के मूल निवास-क्षेत्र को मध्य एशिया से जोड़ा जाता है। भारत में आने के बाद उनकी प्रारंभिक बस्तियाँ मुख्यतः उत्तर-पश्चिमी क्षेत्र में विकसित हुईं। ऋग्वैदिक साहित्य में सप्त-सिंधु क्षेत्र का विशेष महत्व मिलता है।"
    },
    {
        "id": 3,
        "question": "3. ऋग्वैदिक आर्यों की प्रमुख भाषा कौन-सी थी? (a) संस्कृत (b) द्रविड़ (c) पालि (d) प्राकृत",
        "options": [
            "(a) संस्कृत",
            "(b) द्रविड़",
            "(c) पालि",
            "(d) प्राकृत"
        ],
        "correct": 0,
        "explanation": "उत्तर: (a) संस्कृत | व्याख्या: ऋग्वेद की भाषा को वैदिक संस्कृत कहा जाता है। यह बाद की शास्त्रीय संस्कृत से कुछ भिन्न थी। ऋग्वेद वैदिक संस्कृत में रचित सबसे प्राचीन उपलब्ध भारतीय साहित्यिक ग्रंथ माना जाता है।"
    },
    {
        "id": 4,
        "question": "4. ऋग्वेद किस प्रकार का ग्रंथ है? (a) युद्ध का ग्रंथ (b) स्तुतियों/सूक्तों का संग्रह (c) कानून का ग्रंथ (d) चिकित्सा का ग्रंथ",
        "options": [
            "(a) युद्ध का ग्रंथ",
            "(b) स्तुतियों/सूक्तों का संग्रह",
            "(c) कानून का ग्रंथ",
            "(d) चिकित्सा का ग्रंथ"
        ],
        "correct": 1,
        "explanation": "उत्तर: (b) स्तुतियों/सूक्तों का संग्रह | व्याख्या: ऋग्वेद में विभिन्न देवताओं की स्तुति में रचे गए सूक्त और मंत्र संकलित हैं। इसमें अग्नि, इंद्र, सोम, वरुण आदि देवताओं से संबंधित अनेक स्तुतियाँ मिलती हैं। इसलिए ऋग्वेद को मूलतः स्तोत्रात्मक/धार्मिक काव्य-संग्रह माना जाता है।"
    },
    {
        "id": 5,
        "question": "5. ऋग्वेद में कुल कितने मंडल हैं? (a) 8 (b) 10 (c) 12 (d) 18",
        "options": [
            "(a) 8",
            "(b) 10",
            "(c) 12",
            "(d) 18"
        ],
        "correct": 1,
        "explanation": "उत्तर: (b) 10 | व्याख्या: ऋग्वेद 10 मंडलों में विभाजित है। इनमें लगभग 1,028 सूक्त हैं। ऋग्वेद के मंडल विभिन्न ऋषि-परंपराओं और रचनाओं से जुड़े हैं। प्रतियोगी परीक्षाओं में 10 मंडल और 1,028 सूक्त का तथ्य अत्यंत महत्वपूर्ण है।"
    },
    {
        "id": 6,
        "question": "6. ऋग्वेद में लगभग कितने सूक्त हैं? (a) 730 (b) 850 (c) 1,028 (d) 1,500",
        "options": [
            "(a) 730",
            "(b) 850",
            "(c) 1,028",
            "(d) 1,500"
        ],
        "correct": 2,
        "explanation": "उत्तर: (c) 1,028 | व्याख्या: वर्तमान में प्रचलित ऋग्वेद में 10 मंडलों के अंतर्गत 1,028 सूक्त माने जाते हैं। इन सूक्तों में वैदिक देवताओं, प्रकृति, सामाजिक जीवन, धार्मिक विश्वास और तत्कालीन जीवन-पद्धति की जानकारी मिलती है।"
    },
    {
        "id": 7,
        "question": "7. सबसे प्राचीन वेद कौन-सा है? (a) यजुर्वेद (b) सामवेद (c) अथर्ववेद (d) ऋग्वेद",
        "options": [
            "(a) यजुर्वेद",
            "(b) सामवेद",
            "(c) अथर्ववेद",
            "(d) ऋग्वेद"
        ],
        "correct": 3,
        "explanation": "उत्तर: (d) ऋग्वेद | व्याख्या: चारों वेदों में ऋग्वेद सबसे प्राचीन माना जाता है। इसमें देवताओं की स्तुति के मंत्रों का संकलन है। अन्य वेदों की विषय-वस्तु भी ऋग्वैदिक परंपरा से विकसित हुई।"
    },
    {
        "id": 8,
        "question": "8. ‘वेद’ शब्द का अर्थ क्या है? (a) शक्ति (b) ज्ञान (c) युद्ध (d) संपत्ति",
        "options": [
            "(a) शक्ति",
            "(b) ज्ञान",
            "(c) युद्ध",
            "(d) संपत्ति"
        ],
        "correct": 1,
        "explanation": "उत्तर: (b) ज्ञान | व्याख्या: ‘वेद’ शब्द संस्कृत की ‘विद्’ धातु से बना है, जिसका अर्थ है—जानना या ज्ञान प्राप्त करना। इसलिए ‘वेद’ का सामान्य अर्थ ज्ञान माना जाता है। वैदिक साहित्य में वेदों को धार्मिक एवं दार्शनिक ज्ञान का महत्वपूर्ण स्रोत माना गया।"
    },
    {
        "id": 9,
        "question": "9. निम्न में से सबसे प्राचीन वेद कौन-सा है? (a) यजुर्वेद (b) ऋग्वेद (c) सामवेद (d) अथर्ववेद",
        "options": [
            "(a) यजुर्वेद",
            "(b) ऋग्वेद",
            "(c) सामवेद",
            "(d) अथर्ववेद"
        ],
        "correct": 1,
        "explanation": "उत्तर: (b) ऋग्वेद | व्याख्या: ऋग्वेद वैदिक साहित्य की सबसे प्राचीन संहिता है। इसमें मुख्यतः देवताओं की स्तुति में रचे मंत्र हैं। यजुर्वेद का संबंध यज्ञ-विधियों, सामवेद का गायन तथा अथर्ववेद का दैनिक जीवन एवं विभिन्न प्रकार के मंत्रों से अधिक निकटता से है।"
    },
    {
        "id": 10,
        "question": "10. ऋग्वेद में ‘सभ’ और ‘समिति’ किससे संबंधित थीं? (a) धार्मिक ग्रंथ (b) राजनीतिक/सामाजिक संस्थाएँ (c) सैन्य अस्त्र (d) कर व्यवस्था",
        "options": [
            "(a) धार्मिक ग्रंथ",
            "(b) राजनीतिक/सामाजिक संस्थाएँ",
            "(c) सैन्य अस्त्र",
            "(d) कर व्यवस्था"
        ],
        "correct": 1,
        "explanation": "उत्तर: (b) राजनीतिक/सामाजिक संस्थाएँ | व्याख्या: ऋग्वैदिक समाज में सभा और समिति महत्वपूर्ण संस्थाएँ थीं। इनके माध्यम से सामुदायिक एवं राजनीतिक मामलों पर विचार किया जाता था। दोनों संस्थाओं की प्रकृति और कार्यों में अंतर के विषय में विद्वानों के मत हैं, लेकिन सामान्यतः इन्हें जन-जीवन से जुड़ी महत्वपूर्ण संस्थाएँ माना जाता है।"
    },
    {
        "id": 11,
        "question": "11. वैदिक काल में ‘विदथ’ क्या था? (a) धार्मिक ग्रंथ (b) सामाजिक/सामुदायिक संस्था (c) कर का नाम (d) हथियार",
        "options": [
            "(a) धार्मिक ग्रंथ",
            "(b) सामाजिक/सामुदायिक संस्था",
            "(c) कर का नाम",
