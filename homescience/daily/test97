    <!-- 🎯 90 Questions Dataset (बिना explanation, 1-Line Format) -->
    <script>
        const QUIZ_KEY = "medhavi_free_test_d97";

        const dataset = [
            { id: 1, question: "एक युवा व्यक्ति के लिए सही जीविका (करिअर) का चयन करते समय सबसे पहली महत्वपूर्ण बात क्या है?", options: ["केवल अधिक वेतन देने वाले क्षेत्रों की सूची बनाना", "अपनी अभिरुचि, प्रतिभा, व्यक्तिगत प्राथमिकताओं और आवश्यकताओं को पहचानना", "अपने मित्रों और पड़ोसियों के व्यवसायों का अंधानुकरण करना", "पारिवारिक दबाव में आकर किसी भी उपलब्ध नौकरी को स्वीकार करना"], correct: 1 },
            { id: 2, question: "निम्नलिखित में से कौन-सा कथन 'कार्य' की प्रकृति के संबंध में असत्य है?", options: ["कार्य सभी संस्कृतियों का केंद्र बिंदु होता है", "कार्य सदैव केवल धन कमाने के उद्देश्य से ही किया जाता है", "कार्य व्यक्तिगत पहचान विकसित करने और स्वाभिमान बढ़ाने में सहायक है", "कार्य मानव और प्रकृति के सामूहिक प्रयास के रूप में जीवन चक्र में योगदान देता है"], correct: 1 },
            { id: 3, question: "कथन (A): कार्य वह तेल है जो समाज रूपी मशीन के लिए स्नेहक का काम करता है।<br>कारण (R): कार्य न केवल व्यक्ति की आजीविका चलाता है बल्कि समाज और परिवेश में जीवन की गुणवत्ता पर भी प्रभाव डालता है।", options: ["कथन और कारण दोनों सही हैं तथा कारण कथन की सही व्याख्या करता है", "कथन और कारण दोनों सही हैं परंतु कारण कथन की सही व्याख्या नहीं करता है", "कथन सही है परंतु कारण गलत है", "कथन गलत है परंतु कारण सही है"], correct: 0 },
            { id: 4, question: "'अर्थपूर्ण कार्य' की निम्नलिखित में से कौन-सी विशेषता नहीं है?", options: ["यह समाज अथवा अन्य लोगों के लिए उपयोगी होता है", "इसे पूरी ज़िम्मेदारी और आनंद के साथ किया जाता है", "यह कार्य करने वाले को कौशल और समस्या समाधान में समर्थ बनाता है", "यह केवल व्यक्तिगत आर्थिक लाभ के लिए बिना किसी सामाजिक उत्तरदायित्व के किया जाता है"], correct: 3 },
            { id: 5, question: "'नौकरी' और 'करिअर' के बीच मुख्य अंतर क्या है?", options: ["नौकरी जीवन भर चलती है जबकि करिअर केवल युवावस्था तक सीमित होता है", "नौकरी उसके निमित्त कार्य करना है जबकि करिअर जीवन को बेहतर बनाने व आगे बढ़ने की प्रबल इच्छा से जुड़ा है", "नौकरी में उच्च पद और उत्तरदायित्व होता है जबकि करिअर केवल दैनिक मजदूरी है", "नौकरी के लिए नए कौशल सीखना आवश्यक है जबकि करिअर में किसी प्रशिक्षण की जरूरत नहीं होती"], correct: 1 },
            { id: 6, question: "तीन पत्थर तोड़ने वाले व्यक्तियों की दंतकथा में तीसरे व्यक्ति का कथन क्या दर्शाता है?", options: ["वह अपने कार्य को केवल एक साधारण रोज़गार मानता है", "वह अपने कार्य को केवल परिवार के भरण-पोषण की आजीविका मानता है", "वह अपने कार्य को अपनी मनपसंद जीविका और मूर्तिकार बनने के उत्कृष्ट उद्देश्य के रूप में देखता है", "वह अपने कार्य से पूर्णतः असंतुष्ट है और काम छोड़ना चाहता है"], correct: 2 },
            { id: 7, question: "वेबस्टर शब्दकोश के अनुसार 'जीविका' की परिभाषा क्या है?", options: ["केवल दैनिक भरण-पोषण के लिए किया जाने वाला शारीरिक श्रम", "सार्वजनिक, व्यावसायिक अथवा व्यापारिक जीवन से जुड़े निरंतर प्रगतिशील क्षेत्र अथवा व्यवसाय", "घर के भीतर बिना किसी वेतन के किया जाने वाला घरेलू कार्य", "किसी एक संस्था में एक ही पद पर आजीवन बने रहने की प्रक्रिया"], correct: 1 },
            { id: 8, question: "भारत की कुल जनसंख्या का लगभग कितना प्रतिशत भाग ग्रामीण क्षेत्रों में निवास करता है जिनके लिए कृषि रोज़गार का सबसे बड़ा स्रोत है?", options: ["लगभग पचास प्रतिशत", "लगभग सत्तर प्रतिशत", "लगभग चालीस प्रतिशत", "लगभग अस्सी प्रतिशत"], correct: 1 },
            { id: 9, question: "भारत में उगाई जाने वाली कौन-सी फसलें अधिक आर्थिक महत्त्व वाली हैं जिनसे देश को विदेशी मुद्रा प्राप्त होती है?", options: ["गेहूँ, चावल, मक्का और बाजरा", "चना, मसूर, अरहर और मूँग", "चाय, कॉफ़ी, इलायची और रबड़", "आलू, प्याज, टमाटर और गोभी"], correct: 2 },
            { id: 10, question: "भारत विश्व में किन कृषि एवं खाद्य उत्पादों के सबसे अधिक उत्पादन करने वाले देशों में से एक है?", options: ["काजू, नारियल, दूध, अदरक, हल्दी और काली मिर्च", "केसर, अखरोट, बादाम, सेब और जैतून", "सोयाबीन, सूरजमुखी, चुकंदर और जौ", "कोको, वनीला, खजूर और अंजीर"], correct: 0 },
            { id: 11, question: "पारंपरिक भारतीय शिल्पों के संदर्भ में 'शोलापीठ शिल्प' और 'चन्नपटन की मूर्तियाँ' क्रमशः किन राज्यों से संबंधित हैं?", options: ["महाराष्ट्र और केरल", "उड़ीसा और कर्नाटक", "आसाम और राजस्थान", "गुजरात और तमिलनाडु"], correct: 1 },
            { id: 12, question: "'वार्ली चित्रकला' और 'नारियल शिल्प' क्रमशः भारत के किन राज्यों की पारंपरिक कलाएँ हैं?", options: ["कर्नाटक और उड़ीसा", "आसाम और बिहार", "महाराष्ट्र और केरल", "पश्चिम बंगाल और पंजाब"], correct: 2 },
            { id: 13, question: "ऐतिहासिक दृष्टि से भारत में चित्रण कलाओं और शिल्पकारों को मुख्य रूप से किन दो वर्गों के संरक्षकों से सहायता मिलती थी?", options: ["विदेशी व्यापारियों और समुद्री नाविकों से", "बड़े हिंदू मंदिरों और विभिन्न राज्यों के राजसी शासकों से", "आधुनिक बैंकों और औद्योगिक घरानों से", "ग्रामीण पंचायतों और कृषक समितियों से"], correct: 1 },
            { id: 14, question: "परंपरागत रूप से भारतीय शिल्प निर्माण की विधियाँ और कौशल किस प्रकार हस्तांतरित होते थे?", options: ["विश्वविद्यालयों में औपचारिक डिग्री पाठ्यक्रमों के माध्यम से", "परिवार के सदस्यों को पीढ़ी दर पीढ़ी गृह-आधारित प्रशिक्षण द्वारा", "सरकारी समाचार पत्रों और पुस्तकों में प्रकाशन द्वारा", "विदेशी विशेषज्ञों द्वारा संचालित कार्यशालाओं के माध्यम से"], correct: 1 },
            { id: 15, question: "आधुनिक संदर्भ में परंपरागत हस्तशिल्प के पुनरुद्धार और संरक्षण के लिए किन क्षेत्रों में हस्तक्षेप की आवश्यकता है?", options: ["नए डिज़ाइन बनाना, पर्यावरण हितैषी कच्चा माल, पैकेजिंग और बौद्धिक संपदा अधिकार का रक्षण", "पारंपरिक शिल्पों को पूरी तरह बंद करके केवल मशीनी उत्पादन को बढ़ावा देना", "शिल्पकारों को ग्रामीण क्षेत्रों से हटाकर केवल विदेशों में बसाना", "हस्तशिल्प उत्पादों के निर्यात पर पूर्ण प्रतिबंध लगाना"], correct: 0 },
            { id: 16, question: "कथन (A): 'सेक्स' और 'जेंडर' शब्दों के निश्चित रूप से भिन्न अर्थ हैं।<br>कारण (R): सेक्स आनुवंशिकी और जनन अंगों के आधार पर जैविक वर्ग से संबंधित है जबकि जेंडर सामाजिक पहचान पर आधारित है।", options: ["कथन और कारण दोनों सही हैं तथा कारण कथन की सही व्याख्या करता है", "कथन और कारण दोनों सही हैं परंतु कारण कथन की सही व्याख्या नहीं करता है", "कथन सही है परंतु कारण गलत है", "कथन गलत है परंतु कारण सही है"], correct: 0 },
            { id: 17, question: "भारत के सर्वोच्च न्यायालय ने किस वर्ग को 'तीसरे जेंडर' के रूप में मान्यता प्रदान की है?", options: ["वरिष्ठ नागरिकों को", "पारजेंडर लोगों को", "प्रवासी श्रमिकों को", "स्व-नियोजित उद्यमियों को"], correct: 1 },
