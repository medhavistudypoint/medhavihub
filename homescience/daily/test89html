    <!-- 🎯 50 Questions Dataset (बिना explanation, 1-Line Format) -->
    <script>
        const QUIZ_KEY = "medhavi_free_test_d89";

        const dataset = [
            { id: 1, question: "समय (Time) के संबंध में निम्नलिखित में से कौन-सा कथन सत्य है?", options: ["समय को आवश्यकता पड़ने पर बैंक की तरह संचित करके भविष्य के लिए रखा जा सकता है।", "समय सीमित है, इसे दोबारा प्राप्त नहीं किया जा सकता और बीता हुआ समय कभी वापस नहीं आता।", "अत्यधिक प्रभावशाली व्यक्ति अपनी इच्छानुसार समय की गति को धीमा या तेज कर सकते हैं।", "समाज के धनी व्यक्तियों को दिन में निर्धनों की तुलना में अधिक घंटे मिलते हैं।"], correct: 1 },
            { id: 2, question: "समय प्रबंधन का मूल सिद्धांत क्या है?", options: ["दिनभर व्यस्त दिखने का प्रयास करना", "केवल भविष्य की चिंताओं में समय बिताना", "केवल व्यस्त होने की बजाय परिणामों (Results) पर ध्यान देना", "सभी विश्राम और मनोरंजन के अवसरों को पूरी तरह समाप्त कर देना"], correct: 2 },
            { id: 3, question: "तय अवधि में निष्पादित की जाने वाली गतिविधियों की अग्रिम सूची तैयार करने की प्रक्रिया को क्या कहा जाता है?", options: ["समय योजना (Time Plan)", "कार्य सरलीकरण", "कार्य वक्र", "स्थान प्रबंधन"], correct: 0 },
            { id: 4, question: "क्रियाविधि 1 (समय प्रबंधन आत्म-मूल्यांकन) के अनुसार, यदि किसी व्यक्ति के प्राप्तांकों का योग 46 से 75 के बीच आता है, तो इसका क्या अर्थ है?", options: ["व्यक्ति समय प्रबंधन बिल्कुल नहीं कर पा रहा है।", "व्यक्ति अपने समय का प्रबंधन बहुत प्रभावी ढंग से कर रहा है।", "व्यक्ति को अपने दीर्घकालिक कौशल में भारी सुधार की तुरंत आवश्यकता है।", "व्यक्ति केवल तनाव के दबाव में काम कर रहा है।"], correct: 1 },
            { id: 5, question: "समय प्रबंधन कौशल मूल्यांकन में 15 से 30 अंक प्राप्त करने वाले व्यक्ति के लिए पाठ्यपुस्तक में क्या निष्कर्ष दिया गया है?", options: ["वह पहले से ही आदर्श प्रबंधक है।", "उसे किसी सुधार की आवश्यकता नहीं है।", "दीर्घकालीन सफलता और कार्य में प्रभाव सुधारने के लिए उसके पास बड़ा अवसर है, परंतु इसके लिए उसे समय प्रबंधन कौशलों को सुधारना होगा।", "उसे सभी प्रकार के कार्यों को तुरंत बंद कर देना चाहिए।"], correct: 2 },
            { id: 6, question: "समय और गतिविधि योजना के चरणों के संदर्भ में 'कम प्राथमिकता वाले कार्यों' के लिए क्या सुझाव दिया गया है?", options: ["उन्हें सबसे पहले पूरा करना चाहिए।", "'नहीं' कहना सीखें और उनकी ज़िम्मेदारी न लें।", "उनके लिए नींद का त्याग कर देना चाहिए।", "उन्हें अनिवार्य गतिविधियों से ऊपर रखना चाहिए।"], correct: 1 },
            { id: 7, question: "जब किसी बड़े कार्य को प्रबंधित करना हो, तो समय प्रबंधन का कौन-सा चरण सबसे प्रभावी माना गया है?", options: ["बड़े कार्य को किसी अन्य व्यक्ति पर टाल देना।", "बड़े काम को सुविधाजनक गतिविधियों की एक छोटी-छोटी श्रृंखला में विभाजित कर लेना।", "बिना योजना बनाए लगातार 12 घंटे काम करना।", "कार्य को अंतिम तिथि तक बिल्कुल न छूना।"], correct: 1 },
            { id: 8, question: "सुमेलित कीजिए (गतिविधियों के प्रकार एवं उनके उदाहरण):<br><br><table style='width:100%; border-collapse:collapse; margin:10px 0; font-size:15px;' border='1' cellpadding='6'><thead><tr style='background:#f1f5f9; text-align:left;'><th>सूची I (गतिविधि का प्रकार)</th><th>सूची II (उदाहरण)</th></tr></thead><tbody><tr><td>p. दैनिक अनिवार्य गतिविधि</td><td>1. कपड़े धोना, इस्त्री करना, खाद्य वस्तुएं लाना</td></tr><tr><td>q. साप्ताहिक अनिवार्य गतिविधि</td><td>2. घर में धूल झाड़ना, खाना पकाना, स्कूल का काम</td></tr><tr><td>r. मासिक अनिवार्य गतिविधि</td><td>3. स्कूल की मासिक फीस देना, अलमारियां पुनर्व्यवस्थित करना</td></tr><tr><td>s. ऐच्छिक / वैकल्पिक गतिविधि</td><td>4. यात्रा पर जाना, पेड़-पौधे लगाना, उत्सवों में भाग लेना</td></tr></tbody></table>", options: ["p-2, q-1, r-3, s-4", "p-1, q-2, r-4, s-3", "p-2, q-3, r-1, s-4", "p-4, q-1, r-2, s-3"], correct: 0 },
            { id: 9, question: "निम्नलिखित में से कौन-सी गतिविधि 'वार्षिक अनिवार्य गतिविधि' के अंतर्गत वर्गीकृत की गई है?", options: ["प्रतिदिन बर्तन मांजना", "स्कूल की मासिक फीस जमा करना", "वार्षिक परीक्षा, स्कूल के वार्षिक समारोह का आयोजन तथा वार्षिक स्वास्थ्य जांच", "बाजार से साप्ताहिक सब्जियां लाना"], correct: 2 },
            { id: 10, question: "क्रियाविधि 2 में दिए गए कक्षा 12 के एक आदर्श विद्यार्थी की समय योजना के अनुसार, दोपहर 3:00 से 4:00 बजे का समय किसके लिए निर्धारित है?", options: ["स्कूल में रहना", "विश्राम करना / सोना", "रात का भोजन करना", "टीवी देखना और खेलना"], correct: 1 },
            { id: 11, question: "कक्षा 12 के शिक्षार्थी की समय-सारणी में शाम 6:00 से 8:30 बजे तक का समय किस गतिविधि समूह को आवंटित किया गया है?", options: ["केवल स्कूल का गृहकार्य करना", "बाहर खेलना, फुरसत का समय, टीवी देखना, माता-पिता व मित्रों के साथ समय बिताना", "रात की गहरी नींद सोना", "सुबह का नाश्ता करना"], correct: 1 },
            { id: 12, question: "पृष्ठ 111 पर दी गई 'एक ग्रामीण महिला की समय योजना' के अनुसार, सुबह 4:00 से 5:00 बजे तक वह मुख्य रूप से क्या कार्य करती है?", options: ["टीवी देखना और विश्राम करना", "गाय को चारा देना और दुहना", "खेतों से फसल काटना", "बाजार जाकर खरीदारी करना"], correct: 1 },
            { id: 13, question: "ग्रामीण महिला की समय योजना में दोपहर 3:00 से 4:30 अपराह्न का समय किस अनिवार्य घरेलू कार्य के लिए नियत है?", options: ["पूजा-पाठ करना", "भोजन पकाने और पीने के लिए पानी लाना", "रात का भोजन पकाना", "खेत की जुताई करना"], correct: 1 },
            { id: 14, question: "किसी निर्दिष्ट अवधि में काम के अधिकतम बोझ को तकनीकी रूप से क्या कहा जाता है?", options: ["कार्य वक्र", "चरम भार अवधि (Peak Load Period)", "विश्राम अंतराल", "गति अध्ययन"], correct: 1 },
            { id: 15, question: "'कार्य वक्र' (Work Curve) के आरेख में 'a से b' तक का भाग क्या प्रदर्शित करता है?", options: ["थकान के कारण कार्यक्षमता में गिरावट", "कार्य के लिए स्फूर्ति पैदा करने की अवधि (Warming-up period)", "कार्य समाप्ति की अंतिम स्थिति", "पूर्ण विश्राम का अंतराल"], correct: 1 },
            { id: 16, question: "कार्य वक्र में बिंदु 'b' और बिंदु 'd' क्रमशः क्या दर्शाते हैं?", options: ["'b' = काम शुरू होना, 'd' = स्फूर्ति की स्थिति", "'b' = काम करने की अधिकतम क्षमता की स्थिरता, 'd' = थकान के कारण अधिकतम गिरावट", "'b' = विश्राम अंतराल, 'd' = उच्चतम गति", "'b' = पूर्ण अरुचि, 'd' = कार्य समाप्ति"], correct: 1 },
            { id: 17, question: "काम करने के दौरान आने वाली अनुत्पादक रुकावटों अर्थात् 'विश्राम / अंतराल की अवधि' (Rest pauses) के विषय में क्या सावधानी आवश्यक है?", options: ["यह लगातार कम से कम 3 घंटे की होनी चाहिए।", "इसकी आवृत्ति तथा मियाद (अवधि) न तो बहुत लंबी होनी चाहिए और न बहुत छोटी।", "काम के दौरान कोई विश्राम अंतराल होना ही नहीं चाहिए।", "विश्राम केवल कार्य पूरी तरह समाप्त होने के 2 दिन बाद होना चाहिए।"], correct: 1 },
            { id: 18, question: "'कार्य का सरलीकरण' (Work Simplification) की सटीक परिभाषा क्या है?", options: ["सभी जटिल कार्यों को नौकरों से करवाना।", "कार्य करने की सबसे सरल, आसान और अतिशीघ्र विधि से करने की सचेत कोशिश।", "केवल बिजली के भारी उपकरणों का उपयोग करना।", "काम को अधूरा छोड़कर विश्राम करना।"], correct: 1 },
            { id: 19, question: "कार्य सरलीकरण का प्राथमिक संबंध किन दो प्रमुख मानवीय संसाधनों के सही मिश्रण एवं प्रबंधन से है?", options: ["धन और भूमि", "समय और मानव ऊर्जा (Time and Energy)", "वस्त्र और आवास", "भोजन और जल"], correct: 1 },
