<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medhavi Study Point - Home Science Test</title>
    <!-- ✅ सही किया गया CSS कंट्रोल फ़ाइल का पाथ -->
    <link rel="stylesheet" href="../../global-style.css?v=3.0">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body>

    <!-- सुरक्षा वॉटरमार्क स्क्रीन -->
    <div class="watermark-overlay">
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
        <div class="watermark-text">MEDHAVI STUDY POINT</div>
    </div>

    <!-- 1. लॉगिन गेट स्क्रीन -->
    <div id="boxLoginGate" class="login-card">
        <h2>Medhavi Home Science Test Gate</h2>
        <p>कृपया अपना पूरा नाम दर्ज करें और टेस्ट शुरू करें.</p>
        <input type="text" id="txtStudentName" placeholder="अपना नाम यहाँ लिखें..." required>
        <button class="btn-main-action" onclick="validateAndStartQuiz()">परीक्षा शुरू करें 🚀</button>
        <br><br>
        <!-- ✅ सही किया गया बैक बटन का पाथ -->
        <a href="../../homescience.html" style="color:#64748b; font-weight:600; text-decoration:none;">🔙 विषय चयन पर वापस जाएं</a>
    </div>

    <!-- 2. परीक्षा वर्कस्पेस स्क्रीन -->
    <div id="quizWorkspace" class="hidden">
        <!-- 🌟 रिस्पॉन्सिव, सेंटर और 1-लाइन हेडर -->
        <div class="cbt-header" style="background: #0b1e47; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div class="header-left" style="text-align: center; flex: 1; min-width: 220px;">
                <h1 style="color: #facc15; font-size: clamp(18px, 4.8vw, 28px); font-weight: 900; margin: 0; letter-spacing: 0.5px; white-space: nowrap;">MEDHAVI STUDY POINT</h1>
                <p style="color: #ffffff; font-size: clamp(11px, 2.8vw, 14px); margin: 3px 0 0 0; opacity: 0.95; font-weight: 600; white-space: nowrap;">TGT / PGT / NET / DSSSB</p>
            </div>
            <div class="timer-box" id="countdownTimer" style="background: #1e3a8a; border: 2px solid #3b82f6; color: #facc15; padding: 6px 14px; border-radius: 8px; font-size: 18px; font-weight: 800; letter-spacing: 1px; margin: 0 auto;">40:00</div>
        </div>

        <div class="main-container">
            <div class="card-panel">
                <div class="meta-row">
                    <div>
                        <span class="q-badge">प्रश्न: <span id="lblCurrentNum">1</span> / <span id="lblTotalNum">40</span></span>
                        <span class="subject-badge">गृह विज्ञान (Home Science)</span>
                        <!-- 🌟 यहाँ डायनेमिक टैग दिखेगा -->
                        <span id="lblQuestionTag" class="tag-badge"></span>
                    </div>
                </div>
                <div id="boxQuestionText" class="question-text">प्रश्न लोड हो रहा है...</div>
                <div id="boxOptionsList"></div>
                <div class="btn-tri-grid">
                    <button class="btn btn-prev" onclick="doNavigatePrev()">◀ पिछला</button>
                    <button class="btn btn-clear" onclick="doClearAnswer()">Clear</button>
                    <button class="btn btn-mark" onclick="doToggleMark()">⭐ Mark</button>
                </div>
                <button id="btnMainNav" class="btn-main-action" onclick="handleMainAction()">अगला ▶</button>
            </div>
            <div class="card-panel">
                <div class="palette-heading">प्रश्न पैलेट ग्रिड</div>
                <div id="boxPaletteGrid" class="grid-matrix"></div>
                <button class="btn-submit-trigger" onclick="triggerTestSubmission()">✔ Submit Test</button>
            </div>
        </div>
    </div>

    <!-- 3. रिपोर्ट डैशबोर्ड स्क्रीन -->
    <div id="boxReportDashboard" class="report-view">
        <div id="captureTarget" style="padding: 25px; background: white; border-radius: 12px;">
            <div class="report-header-title">Medhavi Study Point — Home Science Result Dashboard</div>
            <p id="lblReportStudentName" style="font-size: 18px; font-weight: bold; text-align: center; color: #0b1e47; margin-bottom: 20px;"></p>
            <div class="grid-5-columns">
                <div class="metric-card-wrapper"><div class="metric-card m-blue"><div id="valNetScore" class="metric-val">0 / 40</div><div class="metric-title">Score</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-green"><div id="valCorrectCount" class="metric-val">0</div><div class="metric-title">Correct</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-red"><div id="valIncorrectCount" class="metric-val">0</div><div class="metric-title">Incorrect</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-orange"><div id="valSkippedCount" class="metric-val">0</div><div class="metric-title">Skipped</div></div></div>
                <div class="metric-card-wrapper"><div class="metric-card m-purple"><div id="valTimeConsumed" class="metric-val">00:00</div><div class="metric-title">Time</div></div></div>
            </div>
        </div>
        <button class="btn-telegram-share" onclick="captureCardAndOpenGroup()">📸 रिजल्ट इमेज कॉपी करें</button>
        <!-- ✅ सही किया गया डैशबोर्ड का बैक बटन -->
        <a href="../../homescience.html" class="btn-dashboard-redirect">🔙 मुख्य डैशबोर्ड पर वापस जाएं</a>
        <div id="boxReviewAnswersList"></div>
    </div>

    <!-- 🎯 टेस्ट डेटासेट और QUIZ_KEY -->
    <script>
        // 1. इस टेस्ट की यूनिक KEY (अपनी आवश्यकता अनुसार बदल भी सकते हैं)
        const QUIZ_KEY = "medhavi_homescience_clinical_nutrition_40q"; 

        // 2. 40 प्रश्नों का डेटासेट
        /* 🌟 यहाँ अपना 40 प्रश्नों का dataset पेस्ट करें 🌟 */

    </script>

    <!-- ✅ सही किया गया JS लॉजिक कंट्रोल फ़ाइल का पाथ -->
    <script src="../../global-quiz.js?v=3.0"></script>
</body>
</html>

